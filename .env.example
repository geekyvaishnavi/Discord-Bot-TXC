# Copy this file to .env and fill in your values. Never commit .env.

# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# Channel IDs (Discord: Settings → Advanced → Developer Mode, then right-click a channel → Copy Channel ID)
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
INTRO_CHANNEL_ID=

# Also send new members a welcome DM (true/false)
WELCOME_DM_ENABLED=false
